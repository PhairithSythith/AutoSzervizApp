@page
@model AutoSzervizApp.Areas.Identity.Pages.Account.ResendEmailConfirmationModel

@{
    ViewData["Title"] = "Megerősítő e-mail újbóli küldése";
}

<div class="row justify-content-center mt-4 mb-5">
    <div class="col-12 col-md-7 col-lg-5">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white text-center py-3">
                <h1 class="h4 mb-0">Megerősítő e-mail újbóli küldése</h1>
            </div>

            <div class="card-body p-4">
                <p class="text-muted text-center mb-4">
                    Add meg a regisztrációkor használt e-mail-címedet
                    az új megerősítő e-mail kéréséhez!
                </p>

                <form method="post">
                    <div asp-validation-summary="All"
                         class="text-danger mb-3"
                         role="alert"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email"
                               class="form-control"
                               autocomplete="username"
                               aria-required="true"
                               placeholder="pelda@email.hu" />
                        <label asp-for="Input.Email">E-mail-cím</label>
                        <span asp-validation-for="Input.Email"
                              class="text-danger"></span>
                    </div>

                    <button type="submit"
                            class="w-100 btn btn-primary btn-lg">
                        Megerősítő e-mail küldése
                    </button>

                    <div class="text-center mt-4">
                        <a asp-page="./Login">
                            Vissza a bejelentkezéshez
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}