@model AutoSzervizApp.Models.ErrorViewModel

@{
    ViewData["Title"] = "Hiba";
}

<h1 class="text-danger">Hiba történt.</h1>
<h2 class="text-danger">A kérés feldolgozása közben hiba lépett fel.</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Hibakeresési azonosító:</strong>
        <code>@Model.RequestId</code>
    </p>
}

<a asp-controller="Home"
   asp-action="Index"
   class="btn btn-secondary">
    Vissza a kezdőlapra
</a>