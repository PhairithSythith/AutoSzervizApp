@model AutoSzervizApp.Models.Munkalap

@{
    ViewData["Title"] = "Új munkalap";
}

<h1>Új munkalap</h1>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Rendszam" class="form-label"></label>
        <input asp-for="Rendszam" class="form-control" />
        <span asp-validation-for="Rendszam" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="JarmuTipusId" class="form-label">Járműtípus</label>
        <select asp-for="JarmuTipusId"
                class="form-select"
                asp-items="ViewBag.JarmuTipusId">
            <option value="">Válassz járműtípust</option>
        </select>
        <span asp-validation-for="JarmuTipusId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="UgyfelId" class="form-label">Ügyfél</label>
        <select asp-for="UgyfelId"
                class="form-select"
                asp-items="ViewBag.UgyfelId">
            <option value="">Válassz ügyfelet</option>
        </select>
        <span asp-validation-for="UgyfelId" class="text-danger"></span>
    </div>

    <div class="mt-2 mb-3">
        <a asp-controller="Ugyfelek"
        asp-action="Create"
        asp-route-vissza="Munkalap"
        class="btn btn-outline-success">
            + Új ügyfél rögzítése
        </a>
    </div>

    <div class="mb-3">
        <label asp-for="Leiras" class="form-label"></label>
        <textarea asp-for="Leiras" class="form-control"></textarea>
        <span asp-validation-for="Leiras" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Mentés</button>
    <a asp-action="Index" class="btn btn-secondary">Vissza</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}