@model IEnumerable<AutoSzervizApp.Models.Munkalap>

@{
    ViewData["Title"] = "Munkalapok";
}

<h1>Munkalapok</h1>

@if (User.IsInRole("Admin") || User.IsInRole("Employee"))
{
    <p>
        <a asp-action="Create" class="btn btn-primary">Új munkalap</a>
    </p>
}
<form asp-action="Index" method="get" class="row g-2 mb-4">
    <div class="col-md-5">
        <input type="text"
               name="keresesiSzoveg"
               value="@ViewBag.AktualisKereses"
               class="form-control"
               placeholder="Keresés rendszám, ügyfél, járműtípus vagy leírás alapján..." />
    </div>

    <div class="col-md-3">
        <select name="statuszSzuro" class="form-select">
            <option value="">-- Minden státusz --</option>
            @foreach (var statusz in Html.GetEnumSelectList<AutoSzervizApp.Models.MunkalapStatusz>())
            {
                if (ViewBag.AktualisStatusz != null &&
                    (int)ViewBag.AktualisStatusz == int.Parse(statusz.Value))
                {
                    <option value="@statusz.Value" selected>@statusz.Text</option>
                }
                else
                {
                    <option value="@statusz.Value">@statusz.Text</option>
                }
            }
        </select>
    </div>

    <div class="col-md-4">
        <button type="submit" class="btn btn-outline-primary">Keresés / szűrés</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Szűrők törlése</a>
    </div>
</form>
<table class="table">
    <thead>
        <tr>
            <th>Azonosító</th>
            <th>Rendszám</th>
            <th>Járműtípus</th>
            <th>Ügyfél</th>
            <th>Státusz</th>
            <th>Felvétel dátuma</th>
            <th>Költség</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
               <td colspan="8">
                    Még nincs rögzített munkalap, vagy nincs a keresésnek megfelelő találat.
                </td>
            </tr>
        }
        else
        {
            @foreach (var munkalap in Model)
            {
                <tr>
                    <td>@munkalap.Id</td>
                    <td>@munkalap.Rendszam</td>
                    <td>
                        @munkalap.JarmuTipus?.Marka
                        @munkalap.JarmuTipus?.Modell
                        (@munkalap.JarmuTipus?.GyartasiEv)
                    </td>
                    <td>@munkalap.Ugyfel?.Nev</td>
                    <td>@Html.DisplayFor(_ => munkalap.Statusz)</td>
                    <td>@munkalap.Letrehozva.ToString("yyyy.MM.dd HH:mm")</td>
                    <td>@munkalap.Koltseg.ToString("N0") Ft</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@munkalap.Id">Részletek</a>
                        <a asp-action="Edit" asp-route-id="@munkalap.Id">Szerkesztés</a>
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-action="Delete" asp-route-id="@munkalap.Id">Törlés</a>
                        }
                    </td>
                </tr>
            }
        }
    </tbody>
</table>