@model AutoSzervizApp.Models.SzervizTipusJavaslat

@{
    ViewData["Title"] = "Új szolgáltatástípus-javaslat";
}

<h1>Új szolgáltatástípus-javaslat</h1>

<p>
    Itt javasolhatsz új szolgáltatást a szerviz számára.
    A javaslatot az adminisztrátor fogja elbírálni.
</p>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Letrehozas" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>
            
            <div class="form-group mb-3">
                <label asp-for="Nev" class="form-label"></label>
                <input asp-for="Nev" class="form-control" />
                <span asp-validation-for="Nev" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Leiras" class="form-label"></label>
                <textarea asp-for="Leiras" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Leiras" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="JavasoltAlapar" class="form-label"></label>
                <input asp-for="JavasoltAlapar" class="form-control" type="number" min="0" step="1" />
                <span asp-validation-for="JavasoltAlapar" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Javaslat beküldése</button>
            <a asp-action="Index" class="btn btn-secondary">Vissza a javaslataimhoz</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
