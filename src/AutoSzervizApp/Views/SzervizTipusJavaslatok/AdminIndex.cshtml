@model IEnumerable<AutoSzervizApp.Models.SzervizTipusJavaslat>

@{
    ViewData["Title"] = "Szolgáltatástípus-javaslatok elbírálása";
}

<h1>Szolgáltatástípus-javaslatok elbírálása</h1>

<p>
    Itt tekintheted meg a munkatársak által beküldött javaslatokat,
    és itt dönthetsz azok elfogadásáról vagy elutasításáról.
</p>

@if (TempData["Siker"] != null)
{
    <div class="alert alert-success">
        @TempData["Siker"]
    </div>
}

@if (TempData["Hiba"] != null)
{
    <div class="alert alert-danger">
        @TempData["Hiba"]
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">
        Jelenleg nincs egyetlen beküldött javaslat sem.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">
            <thead>
                <tr>
                    <th>Szolgáltatás neve</th>
                    <th>Leírás</th>
                    <th>Javasolt ár</th>
                    <th>Javaslattevő</th>
                    <th>Beküldés időpontja</th>
                    <th>Állapot</th>
                    <th>Admin megjegyzése</th>
                    <th>Elbírálás</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var javaslat in Model)
                {
                    <tr>
                        <td>@javaslat.Nev</td>
                        <td>@javaslat.Leiras</td>
                        <td>@javaslat.JavasoltAlapar.ToString("N0") Ft</td>
                        <td>
                            @(javaslat.JavasloFelhasznalo?.Email
                                ?? javaslat.JavasloFelhasznalo?.UserName
                                ?? "Ismeretlen felhasználó")
                        </td>
                        <td>@javaslat.Letrehozva.ToLocalTime().ToString("yyyy. MM. dd. HH:mm")</td>
                        <td>
                            @switch (javaslat.Allapot)
                            {
                                case AutoSzervizApp.Models.JavaslatAllapot.Fuggoben:
                                    <span class="badge bg-warning text-dark">Elbírálásra vár</span>
                                    break;

                                case AutoSzervizApp.Models.JavaslatAllapot.Elfogadva:
                                    <span class="badge bg-success">Elfogadva</span>
                                    break;

                                case AutoSzervizApp.Models.JavaslatAllapot.Elutasitva:
                                    <span class="badge bg-danger">Elutasítva</span>
                                    break;
                            }
                        </td>
                        <td>@javaslat.AdminMegjegyzes</td>
                        <td>
                            @if (javaslat.Allapot == AutoSzervizApp.Models.JavaslatAllapot.Fuggoben)
                            {
                                <form asp-action="Elbiralas" method="post">
                                    <input type="hidden" name="id" value="@javaslat.Id" />

                                    <div class="mb-2">
                                        <label class="form-label" for="megjegyzes-@javaslat.Id">
                                            Megjegyzés
                                        </label>
                                        <textarea id="megjegyzes-@javaslat.Id"
                                                  name="adminMegjegyzes"
                                                  class="form-control"
                                                  rows="2"
                                                  maxlength="500"></textarea>
                                    </div>

                                    <button type="submit"
                                            name="allapot"
                                            value="Elfogadva"
                                            class="btn btn-success btn-sm mb-1">
                                        Elfogadás
                                    </button>

                                    <button type="submit"
                                            name="allapot"
                                            value="Elutasitva"
                                            class="btn btn-danger btn-sm mb-1">
                                        Elutasítás
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span class="text-muted">Már elbírálva</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
