@model AutoSzervizApp.Models.Ugyfel

@{
    ViewData["Title"] = "Ügyfél törlése";
}

<h1>Ügyfél törlése</h1>

<p>Biztosan törlöd ezt az ügyfelet?</p>

<dl class="row">
    <dt class="col-sm-2">Név</dt>
    <dd class="col-sm-10">@Model.Nev</dd>

    <dt class="col-sm-2">Telefonszám</dt>
    <dd class="col-sm-10">@Model.Telefon</dd>

    <dt class="col-sm-2">E-mail-cím</dt>
    <dd class="col-sm-10">@Model.EmailCim</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Törlés</button>
    <a asp-action="Index" class="btn btn-secondary">Mégse</a>
</form>