@model AutoSzervizApp.Models.Ugyfel

@{
    ViewData["Title"] = "Új ügyfél";
}

<h1>Új ügyfél</h1>

<form asp-action="Create" method="post">
    <input type="hidden" name="vissza" value="@ViewBag.Vissza" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Nev" class="form-label"></label>
        <input asp-for="Nev" class="form-control" />
        <span asp-validation-for="Nev" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Telefon" class="form-label"></label>
        <input asp-for="Telefon" class="form-control" />
        <span asp-validation-for="Telefon" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="EmailCim" class="form-label"></label>
        <input asp-for="EmailCim" class="form-control" />
        <span asp-validation-for="EmailCim" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Mentés</button>
    @if (ViewBag.Vissza?.ToString() == "Munkalap")
    {
        <a asp-controller="Munkalapok"
        asp-action="Create"
        class="btn btn-secondary">
            Vissza a munkalap rögzítéséhez
        </a>
    }
    else
    {
        <a asp-action="Index" class="btn btn-secondary">Vissza</a>
    }
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}