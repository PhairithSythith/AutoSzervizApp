@model AutoSzervizApp.Models.AdminUjFelhasznaloViewModel

@{
    ViewData["Title"] = "Új dolgozó felvétele";
}

<h1>Új dolgozó felvétele</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="UjFelhasznalo" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Jelszo" class="form-label"></label>
                <input asp-for="Jelszo" class="form-control" />
                <span asp-validation-for="Jelszo" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="JelszoMegerositese" class="form-label"></label>
                <input asp-for="JelszoMegerositese" class="form-control" />
                <span asp-validation-for="JelszoMegerositese"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Szerepkor" class="form-label"></label>
                <select asp-for="Szerepkor" class="form-select">
                    <option value="Employee">Dolgozó (Employee)</option>
                    <option value="Admin">Adminisztrátor (Admin)</option>
                </select>
                <span asp-validation-for="Szerepkor" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">
                Dolgozó létrehozása
            </button>

            <a asp-action="Index" class="btn btn-secondary">Vissza</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}