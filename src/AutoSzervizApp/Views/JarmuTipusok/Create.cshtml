@model AutoSzervizApp.Models.JarmuTipus

@{
    ViewData["Title"] = "Új járműtípus";
}

<h1>Új járműtípus</h1>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Marka" class="form-label"></label>
        <input asp-for="Marka" class="form-control" />
        <span asp-validation-for="Marka" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Modell" class="form-label"></label>
        <input asp-for="Modell" class="form-control" />
        <span asp-validation-for="Modell" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="GyartasiEv" class="form-label"></label>
        <input asp-for="GyartasiEv" class="form-control" />
        <span asp-validation-for="GyartasiEv" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Mentés</button>
    <a asp-action="Index" class="btn btn-secondary">Vissza</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}