@model AutoSzervizApp.Models.Jarmu

@{
    ViewData["Title"] = "Jármű törlése";
}

<h1 class="text-danger">Jármű törlése</h1>
<h3>Biztosan törölni szeretnéd ezt a járművet?</h3>
<hr />

<div>
    <dl class="row">
        <dt class="col-sm-2">Rendszám</dt>
        <dd class="col-sm-10">@Model.Rendszam</dd>

        <dt class="col-sm-2">Járműtípus</dt>
        <dd class="col-sm-10">
            @Model.JarmuTipus?.Marka
            @Model.JarmuTipus?.Modell
            (@Model.JarmuTipus?.GyartasiEv)
        </dd>

        <dt class="col-sm-2">Ügyfél</dt>
        <dd class="col-sm-10">@Model.Ugyfel?.Nev</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Törlés véglegesítése</button>
        <a asp-action="Index" class="btn btn-secondary">Mégse</a>
    </form>
</div>