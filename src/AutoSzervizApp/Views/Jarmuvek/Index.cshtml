@model IEnumerable<AutoSzervizApp.Models.Jarmu>

@{
    ViewData["Title"] = "Járművek";
}

<h1>Járművek</h1>

@if (User.IsInRole("Admin"))
{
    <p>
        <a asp-action="Create" class="btn btn-primary">Új jármű felvétele</a>
    </p>
}

<table class="table">
    <thead>
        <tr>
            <th>Rendszám</th>
            <th>Járműtípus</th>
            <th>Ügyfél</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="4">Még nincs rögzített jármű.</td>
            </tr>
        }
        else
        {
            @foreach (var jarmu in Model)
            {
                <tr>
                    <td>@jarmu.Rendszam</td>
                    <td>
                        @jarmu.JarmuTipus?.Marka
                        @jarmu.JarmuTipus?.Modell
                        (@jarmu.JarmuTipus?.GyartasiEv)
                    </td>
                    <td>@jarmu.Ugyfel?.Nev</td>
                    <td>
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-action="Edit" asp-route-id="@jarmu.Id">Szerkesztés</a>
                        }
                    </td>
                </tr>
            }
        }
    </tbody>
</table>